# Personal API token from https://app.tmetric.com/#/profile ("Get new API token").
# Valid for 1 year; generating a new one invalidates the previous token.
TMETRIC_API_TOKEN=your_token_here

# Optional. Default workspace (accountId) used when a tool call omits account_id.
# When unset, the server uses the active workspace from your TMetric profile.
# TMETRIC_ACCOUNT_ID=123456

# Optional. Default user (userId) used when a tool call omits user_id.
# When unset, the server uses the authenticated user's own id.
# TMETRIC_USER_ID=654321

# Optional. Override for self-hosted / on-premises installations.
# TMETRIC_BASE_URL=https://app.tmetric.com
